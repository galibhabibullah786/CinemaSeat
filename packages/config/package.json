{
  "name": "@baseplate/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared tsconfig, ESLint flat config and Prettier config. The ONLY place these live.",
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.node.json": "./tsconfig.node.json",
    "./tsconfig.react.json": "./tsconfig.react.json",
    "./eslint": "./eslint.config.js",
    "./eslint-react": "./eslint.react.js",
    "./prettier": "./prettier.config.js"
  },
  "files": [
    "tsconfig.base.json",
    "tsconfig.node.json",
    "tsconfig.react.json",
    "eslint.config.js",
    "eslint.react.js",
    "prettier.config.js"
  ],
  "dependencies": {
    "@eslint/js": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.18.1"
  },
  "peerDependencies": {
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
