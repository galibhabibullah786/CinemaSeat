{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@baseplate/config/react",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /* Vite bundles; it does not use tsc for emit. Bundler resolution lets us
       import "./foo" without an extension the way every React codebase does. */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  }
}
