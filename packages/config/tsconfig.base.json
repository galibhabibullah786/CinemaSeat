{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@baseplate/config/base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* --- strictness: the point of using TypeScript at all --- */
    "strict": true,
    /* Indexing an array or Record yields `T | undefined`. This is the option
       that catches the classic `arr[0].id` crash at compile time. It is off by
       default in `strict` and is the single highest-value flag here. */
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,

    /* --- emit --- */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "exclude": ["node_modules", "dist"]
}
