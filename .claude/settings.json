{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Claude Code settings. The 'instructions' field points Claude Code at the same canonical agent file every other agent tool reads.",
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm run build)",
      "Bash(pnpm run test*)",
      "Bash(pnpm exec prisma*)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make build)",
      "Bash(make test*)",
      "Bash(make e2e)",
      "Bash(make ci-local)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs*)",
      "Bash(docker compose exec*)"
    ]
  }
}
