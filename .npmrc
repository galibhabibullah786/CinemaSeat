# Fail fast when the local Node/pnpm does not match `engines` in package.json.
# A hackathon loses hours to "works on my machine"; this turns that into a
# one-line error at install time instead of a mystery at runtime.
engine-strict=true

# Keep peer resolution honest but non-blocking: a peer mismatch should be a
# warning you can read, not a wall you hit at 3am.
strict-peer-dependencies=false
auto-install-peers=true
