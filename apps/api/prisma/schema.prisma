// Prisma schema. Postgres 16.
//
// Convention: snake_case in the database (what a DBA expects), camelCase in
// TypeScript (what the language expects). @map/@@map bridges the two so
// neither side has to compromise.

generator client {
  provider = "prisma-client-js"

  // Build engines for BOTH the host (npm install runs on Debian/Ubuntu CI)
  // and the container (alpine:3.21, musl). The default `native` target only
  // covers whichever platform the GENERATION ran on; without this list the
  // service crashes on first query with "could not locate the Query Engine
  // for runtime linux-musl-openssl-3.0.x".
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]

  // Explicit output, deliberately OUTSIDE src/ and dist/.
  //
  // Two problems this solves at once:
  //   1. The default location is inside node_modules/.pnpm/<hashed dir>/, so a
  //      `pnpm deploy --prod` reinstalls @prisma/client fresh and DISCARDS the
  //      generated client. The container then starts fine and fails on its
  //      first query with "@prisma/client did not initialize yet".
  //   2. Generated code here is part of the package directory, so it is copied
  //      by `pnpm deploy` like any other build output -- no regeneration (and
  //      therefore no Prisma CLI) is needed in the runtime image.
  //
  // It must not live in src/: tsc would typecheck the .d.ts but never copy the
  // .js to dist/. It must not live in dist/: `pnpm clean` would delete it.
  // As a sibling of both, the relative import '../../generated/prisma/index.js'
  // resolves identically from src/db/ and from dist/db/.
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id              String     @id @default(uuid())
  title           String     @db.VarChar(200)
  synopsis        String?    @db.Text
  posterUrl       String?    @map("poster_url") @db.VarChar(500)
  backdropUrl     String?    @map("backdrop_url") @db.VarChar(500)
  durationMinutes Int        @map("duration_minutes")
  certificate     String?    @db.VarChar(20)
  genres          String[]   @default([])
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  showtimes       Showtime[]

  @@map("movies")
}

model Theatre {
  id        String     @id @default(uuid())
  name      String     @db.VarChar(200)
  location  String?    @db.VarChar(300)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  screens   Screen[]
  showtimes Showtime[]

  @@map("theatres")
}

model Screen {
  id        String     @id @default(uuid())
  theatreId String     @map("theatre_id")
  name      String     @db.VarChar(100)
  capacity  Int
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  theatre   Theatre    @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  seats     Seat[]
  showtimes Showtime[]

  @@map("screens")
}

model Seat {
  id          String          @id @default(uuid())
  screenId    String          @map("screen_id")
  rowLabel    String          @map("row_label") @db.VarChar(10)
  seatNumber  Int             @map("seat_number")
  seatClass   String          @default("Standard") @map("seat_class") @db.VarChar(50)
  priceCents  Int             @map("price_cents")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  screen      Screen          @relation(fields: [screenId], references: [id], onDelete: Cascade)
  inventories SeatInventory[]
  bookingSeats BookingSeat[]

  @@unique([screenId, rowLabel, seatNumber])
  @@map("seats")
}

model Showtime {
  id          String          @id @default(uuid())
  movieId     String          @map("movie_id")
  theatreId   String          @map("theatre_id")
  screenId    String          @map("screen_id")
  startsAt    DateTime        @map("starts_at") @db.Timestamptz(3)
  priceCents  Int             @map("price_cents")
  currency    String          @default("USD") @db.VarChar(10)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  movie       Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  theatre     Theatre         @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  screen      Screen          @relation(fields: [screenId], references: [id], onDelete: Cascade)
  inventories SeatInventory[]
  bookings    Booking[]

  @@index([movieId])
  @@index([startsAt])
  @@map("showtimes")
}

model SeatInventory {
  id         String    @id @default(uuid())
  showtimeId String    @map("showtime_id")
  seatId     String    @map("seat_id")
  status     String    @default("AVAILABLE") @db.VarChar(30)
  priceCents Int       @map("price_cents")
  version    Int       @default(1)
  heldUntil        DateTime? @map("held_until") @db.Timestamptz(3)
  holdingBookingId String?   @map("holding_booking_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  showtime   Showtime  @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat       Seat      @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@unique([showtimeId, seatId])
  @@map("seat_inventories")
}

model Booking {
  id           String        @id @default(uuid())
  ref          String        @unique @db.VarChar(50)
  showtimeId   String        @map("showtime_id")
  status       String        @default("HELD") @db.VarChar(30)
  amountCents  Int           @map("amount_cents")
  currency     String        @default("USD") @db.VarChar(10)
  phone        String?       @db.VarChar(50)
  qrPayload    String?       @map("qr_payload") @db.VarChar(255)
  expiresAt    DateTime?     @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  showtime     Showtime      @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]

  @@map("bookings")
}

model BookingSeat {
  id         String   @id @default(uuid())
  bookingId  String   @map("booking_id")
  seatId     String   @map("seat_id")
  priceCents Int      @map("price_cents")

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat       Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@unique([bookingId, seatId])
  @@map("booking_seats")
}

/// Idempotency ledger. Generic on purpose: it survives `make reset-domain`
/// and is the reference implementation the real domain copies tomorrow.
///
/// The uniqueness of (endpoint, key) is the ENFORCEMENT layer for "process
/// this request at most once". It is enforced here, in the database, and not
/// in the service, because only the database sees all concurrent transactions.
/// A check-then-act in application code loses that race every time.
model IdempotencyRecord {
  /// Client-supplied Idempotency-Key header value.
  key String @db.VarChar(255)

  /// Logical operation, e.g. "POST /items". Scoping by endpoint stops the same
  /// key on a different route from replaying an unrelated response.
  endpoint String @db.VarChar(120)

  /// SHA-256 of the canonical request body. A repeat of the SAME key with a
  /// DIFFERENT body is a client bug and must be rejected, not replayed.
  requestHash String @map("request_hash") @db.Char(64)

  /// The original response, replayed verbatim on retry.
  statusCode   Int    @map("status_code")
  responseBody Json   @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Retention sweep target. Idempotency records are not kept forever; see
  /// docs/runbook.md. Without this index the cleanup becomes a seq scan.
  @@id([endpoint, key])
  @@index([createdAt])
  @@map("idempotency_records")
}
