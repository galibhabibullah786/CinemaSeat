# =============================================================================
#  Copy to `.env` and adjust:  cp .env.example .env
#  `.env` is gitignored. Never commit real credentials. Never bake them into
#  an image layer -- layers are extractable with `docker save`.
#  EVERY variable the system reads is listed here. If code reads a var that is
#  not in this file, that is a bug in the code, not in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# "development" | "test" | "production". Controls log formatting and whether
# Express leaks stack traces (it never does in our handler, but be explicit).
NODE_ENV=development

# Port the API listens on INSIDE the container / process.
API_PORT=4000

# pino level: trace|debug|info|warn|error|fatal
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (Postgres 16)
# -----------------------------------------------------------------------------
# Credentials used to initialise the Postgres container in compose.
# In production these come from the deploy host's .env, never from git.
POSTGRES_USER=baseplate
POSTGRES_PASSWORD=baseplate_dev_only_change_me
POSTGRES_DB=baseplate

# Host port for Postgres. DEV ONLY -- compose.prod.yaml deliberately does not
# publish this port at all (criterion 4: Postgres unreachable from the host).
POSTGRES_HOST_PORT=5432

# Prisma connection string.
#   - running the API on the host (make dev):        host=localhost
#   - running the API in compose (make prod):        host=db   (compose sets it)
# connection_limit is sized by Little's Law -- see .agents/skills/performance-and-scale.md
DATABASE_URL=postgresql://baseplate:baseplate_dev_only_change_me@localhost:5432/baseplate?schema=public&connection_limit=10&pool_timeout=10

# Separate database for the integration suite so `make test` can never
# truncate the database you are demoing from.
TEST_DATABASE_URL=postgresql://baseplate:baseplate_dev_only_change_me@localhost:5432/baseplate_test?schema=public

# -----------------------------------------------------------------------------
# HTTP security
# -----------------------------------------------------------------------------
# Comma-separated exact origins. NEVER "*" -- an allowlist is the whole point.
# Must include the origin the browser actually loads the web app from.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Max JSON body size accepted by express.json(). Rejects oversized payloads
# before they reach a handler.
BODY_LIMIT=100kb

# In-memory write rate limiter. Per-process -- see the comment in
# apps/api/src/http/middleware/rate-limit.ts about why this must become Redis
# the moment there is more than one replica.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=60

# Hard cap on graceful shutdown. After this, the process exits non-zero rather
# than hanging a rolling deploy forever.
SHUTDOWN_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Web (Vite)
# -----------------------------------------------------------------------------
# Baked into the client bundle AT BUILD TIME. It is public by definition --
# never put a secret in a VITE_* variable.
# The build FAILS LOUDLY if this is unset (see apps/web/vite.config.ts).
VITE_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Compose / deploy
# -----------------------------------------------------------------------------
# Host port the public entry point (nginx serving the web app) binds to.
WEB_PORT=8080

# Dev-only: host port for the API. compose.prod.yaml does NOT publish this;
# in prod the API is reachable only via nginx on the frontend network.
API_HOST_PORT=4000

# Image coordinates. CD overwrites IMAGE_TAG with the immutable sha-<short-sha>.
GHCR_REGISTRY=ghcr.io
GHCR_NAMESPACE=your-github-user-or-org
IMAGE_TAG=latest
